diff --git a/zig/src/families/flashnext/cuda_kv_lanes.zig b/zig/src/families/flashnext/cuda_kv_lanes.zig
index ca408da95..799f7e72f 100644
--- a/zig/src/families/flashnext/cuda_kv_lanes.zig
+++ b/zig/src/families/flashnext/cuda_kv_lanes.zig
@@ -1,4 +1,4 @@
-//! Flash Next's streams beside the first take attention-cache pages from the core pool (TF_FLASHNEXT_KV_PAGES=n).
+//! Flash Next's streams take attention-cache pages from the core pool (TF_FLASHNEXT_KV_PAGES=n, _ALL=1: every one).
 const std = @import("std");
 const cuda = @import("cuda");
 const kv = @import("core").kv_pool;
@@ -24,12 +24,22 @@ pub fn pagingOf(v: ?[]const u8) !usize {
     return n;
 }
 
-/// TF_FLASHNEXT_KV_PAGES_ALL=1: every stream on pages, none on its own contiguous caches (checks).
+/// TF_FLASHNEXT_KV_PAGES_ALL=1: every stream on pages, none on its own contiguous caches.
 pub fn pagedOnly() bool {
     const v = @import("core").profile.get(.TF_FLASHNEXT_KV_PAGES_ALL) orelse return false;
     return std.mem.eql(u8, v, "1");
 }
 
+/// With pages and TF_FLASHNEXT_KV_PAGES_ALL=1 the engine's own stream takes pages too: the plan sets a window aside.
+pub fn enginePaged(page_tokens: usize) bool {
+    return page_tokens > 0 and pagedOnly();
+}
+
+/// The pool's lanes for `streams` beside the engine's own, and one for it when it takes pages too.
+pub fn poolLanes(streams: u32, engine_paged: bool) u32 {
+    return streams + @intFromBool(engine_paged);
+}
+
 /// Pages a stream maps at most: a full window and one more drafted window.
 fn mostPages(capacity: usize, tokens: usize) usize {
     return (capacity + windowRows() + tokens - 1) / tokens;
@@ -66,6 +76,7 @@ pub const State = struct {
     pool: ?*Pool = null,
     layout: ?kv.Layout = null,
     head: ?Head = null,
+    /// TF_FLASHNEXT_KV_PAGES_ALL=1: every stream, the engine's own too, on a pool lane.
     paged_only: bool = false,
     own_busy: bool = false,
 
@@ -74,6 +85,12 @@ pub const State = struct {
         return if (!s.paged_only and !s.own_busy) .own else .pool;
     }
 
+    /// The pool /metrics reports, with the run of pages each open claims first; null without pages.
+    pub fn source(s: *const State) ?kv.Source {
+        const p = s.pool orelse return null;
+        return .{ .pool = &p.pool, .page_tokens = @intCast(p.layout.page_tokens), .run_pages = @intCast(p.layout.runPages()) };
+    }
+
     pub fn opened(s: *State, from: From) void {
         if (from == .own) s.own_busy = true;
     }
@@ -420,6 +437,23 @@ test "a stream's pages: its rows and a drafted window, no more than a full windo
     try std.testing.expect(l.pages(40960 + windowRows()) <= mostPages(40960, 256));
 }
 
+test "every stream on pages at 262,144 x 8: the engine's window is pool pages any stream takes, not a share held idle" {
+    const window = 262144 + windowRows();
+    const l = layout(262144, 256, .{ .draft_n = 32768, .rows = 3072 }, 0);
+    const room: u64 = 14 << 30;
+    const b: kv.Budget = .{ .room = room, .engine = 0, .lanes = 8, .window = window, .engine_paged = true, .asked = true };
+    const all = try kv.plan(l, b);
+    try std.testing.expectEqual(@as(u32, 8), all.lanes);
+    try std.testing.expectEqual(@as(u32, 8), poolLanes(all.lanes - 1, true)); // a lane each, the engine's own too
+    try std.testing.expect(all.pages >= l.pages(window) + 7 * (1 + l.runPages())); // one full window beside 7 starts
+    // the engine's window held contiguous beside the pool: the other 7 share what it leaves, under one window
+    var held = b;
+    held.room = room - l.pages(window) * l.pageBytes();
+    held.engine_paged = false;
+    const before = try kv.plan(l, held);
+    try std.testing.expect(before.pages < l.pages(window) and all.pages > before.pages + l.pages(window) / 2);
+}
+
 test {
     _ = @import("cuda_kv_init_test.zig");
     _ = @import("cuda_kv_lifetime_test.zig");
