+        for (limits.sms, r.usage) |sm, u| missing += @intFromBool(registry.targetDecision(r, sm, u) == .applicable and u.regs == 0);
+        try std.testing.expectEqual(missing, try registry.checkCuda(std.testing.allocator, &.{r}, true));
+    }
+}
