+//! Fused BF16 routed experts (gate_up_proj [E, 2W, D], down_proj [E, D, W]) quantized at load to the block-FP8 form.
+const std = @import("std");
+const core = @import("core");
+const cuda = @import("cuda");
+const experts = @import("cuda_modelopt_experts.zig");
+const fp8 = @import("cuda_fp8_experts_load.zig");
+const wt = @import("cuda_prompt_wt.zig");
+const fx = cuda.experts.Fp8Experts;
+
+const blk = fx.block;
+const encode = core.exlr8.codec.e4m3FromF32;
+
+/// Whether `prefix` holds fused routed experts in place of one tensor a projection and expert.
+pub fn present(store: *const wt.Store, prefix: []const u8) bool {
+    var a: [512]u8 = undefined;
+    var b: [512]u8 = undefined;
+    const gu = std.fmt.bufPrint(&a, "{s}.experts.gate_up_proj", .{prefix}) catch return false;
+    const dn = std.fmt.bufPrint(&b, "{s}.experts.down_proj", .{prefix}) catch return false;
+    return store.has(gu) and store.has(dn);
+}
+
+/// One BF16 weight [n, k] as E4M3 codes and f32 scales [n/128][k/128], each block's scale its BF16-rounded amax / 448.
+pub fn quantize(w: []const u8, n: usize, k: usize, codes: []u8, scales: []f32) void {
+    std.debug.assert(w.len == n * k * 2 and codes.len == n * k and scales.len == (n / blk) * (k / blk));
+    const src = std.mem.bytesAsSlice(u16, @as([]align(1) const u8, w));
+    for (0..n / blk) |bi| for (0..k / blk) |bj| {
+        var amax: f32 = 0;
+        for (0..blk) |r| for (0..blk) |c| {
+            amax = @max(amax, @abs(wt.promote(src[(bi * blk + r) * k + bj * blk + c])));
+        };
+        // the stored scale is BF16 as the checkpoint FP8 heads keep it; an all-zero block keeps scale 1 and zero codes
+        const scale = if (amax == 0) 1.0 else wt.promote(wt.toBf16(amax / 448.0));
+        scales[bi * (k / blk) + bj] = scale;
+        for (0..blk) |r| for (0..blk) |c| {
+            const at = (bi * blk + r) * k + bj * blk + c;
+            codes[at] = encode(wt.promote(src[at]) / scale);
+        };
+    };
+}
+
+/// A layer of `count` fused experts on one GPU as experts.Owned in the .fp8g format cuda_fp8_experts_load.zig loads.
+pub fn load(a: std.mem.Allocator, d: *const cuda.Driver, store: *wt.Store, prefix: []const u8, world: usize, dims: usize, width: usize, count: usize) !experts.Owned {
+    defer store.release();
+    if (world != 1) return error.UnevenExpertSplit;
+    const one = try fp8.Shape.of(dims, width);
+    var buf: [512]u8 = undefined;
+    const gu = try store.hold(try std.fmt.bufPrint(&buf, "{s}.experts.gate_up_proj", .{prefix}));
+    if (!gu.is(.bf16, &.{ count, 2 * width, dims })) return error.UnexpectedTensor;
+    const dn = try store.hold(try std.fmt.bufPrint(&buf, "{s}.experts.down_proj", .{prefix}));
+    if (!dn.is(.bf16, &.{ count, dims, width })) return error.UnexpectedTensor;
+    var up = try cuda.DeviceBuffer.alloc(d, count * one.up * 4);
+    errdefer up.free();
+    var down = try cuda.DeviceBuffer.alloc(d, count * one.down * 4);
+    errdefer down.free();
+    const up_scale = try a.alloc(f32, count * one.up_scale);
+    defer a.free(up_scale);
+    const down_scale = try a.alloc(f32, count * one.down_scale);
+    defer a.free(down_scale);
+    const up_words = try a.alloc(u32, one.up);
+    defer a.free(up_words);
+    const down_words = try a.alloc(u32, one.down);
+    defer a.free(down_words);
+    const gate_codes = try a.alloc(u8, width * dims);
+    defer a.free(gate_codes);
+    const up_codes = try a.alloc(u8, width * dims);
+    defer a.free(up_codes);
+    const down_codes = try a.alloc(u8, dims * width);
+    defer a.free(down_codes);
+    const proj = width * dims * 2; // one projection's BF16 bytes
+    const half = one.up_scale / 2;
+    for (0..count) |i| {
+        const s = up_scale[i * one.up_scale ..][0..one.up_scale];
+        quantize(gu.bytes[(2 * i) * proj ..][0..proj], width, dims, gate_codes, s[0..half]);
+        quantize(gu.bytes[(2 * i + 1) * proj ..][0..proj], width, dims, up_codes, s[half..]);
+        quantize(dn.bytes[i * proj ..][0..proj], dims, width, down_codes, down_scale[i * one.down_scale ..][0..one.down_scale]);
+        try fx.packGateUp(a, up_words, gate_codes, up_codes, width, dims);
+        fx.packOne(down_words, down_codes, dims, width);
+        try up.upload(i * one.up * 4, std.mem.sliceAsBytes(up_words));
+        try down.upload(i * one.down * 4, std.mem.sliceAsBytes(down_words));
+    }
+    var us = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(up_scale));
+    errdefer us.free();
+    const ds = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(down_scale));
+    return .{ .up = up, .down = down, .up_scale = us, .down_scale = ds, .width = width, .dims = dims, .count = count, .format = .fp8g };
+}
+
+test "fused BF16 blocks quantize to E4M3 under their BF16 amax/448 scale, zero blocks to scale 1" {
+    const n = 2 * blk;
+    const k = blk;
+    var w: [n * k]u16 = undefined;
+    for (0..n * k) |i| w[i] = if (i < blk * k) wt.toBf16(@as(f32, @floatFromInt(@as(i32, @intCast(i % 97)) - 48)) * 0.125) else 0;
+    var codes: [n * k]u8 = undefined;
+    var scales: [2]f32 = undefined;
+    quantize(std.mem.sliceAsBytes(&w), n, k, &codes, &scales);
+    try std.testing.expectEqual(wt.promote(wt.toBf16(6.0 / 448.0)), scales[0]);
+    try std.testing.expectEqual(@as(f32, 1), scales[1]);
+    for (0..blk * k) |i| {
+        const back = core.exlr8.codec.e4m3Value(codes[i]) * scales[0];
+        const want = wt.promote(w[i]);
+        try std.testing.expect(@abs(back - want) <= @abs(want) / 16 + scales[0] * 0x1p-9);
+    }
+    for (blk * k..n * k) |i| try std.testing.expectEqual(@as(u8, 0), codes[i]);
+}
