+//! A ModelOpt config that states one NVFP4 group and an ignore list, read as the per-layer layout it describes.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// Modules a uniform NVFP4 config must leave BF16 (match an ignore pattern), one layer's names a time.
+fn bf16Modules(layer: usize, buf: *[8][128]u8, out: *[8][]const u8) ![]const []const u8 {
+    const linear = wt.linearLayer(layer);
+    const prefix = if (linear) "linear_attn" else "self_attn";
+    const parts: []const []const u8 = if (linear) &.{ "in_proj_qkv", "in_proj_z", "in_proj_b", "in_proj_a", "out_proj" } else &.{ "q_proj", "k_proj", "v_proj", "indexer.index_qk_proj", "o_proj" };
+    var n: usize = 0;
+    for (parts) |part| {
+        out[n] = try std.fmt.bufPrint(&buf[n], "model.language_model.layers.{d}.{s}.{s}", .{ layer, prefix, part });
+        n += 1;
+    }
+    for ([_][]const u8{ "gate_proj", "up_proj", "down_proj" }) |part| {
+        out[n] = try std.fmt.bufPrint(&buf[n], "model.language_model.layers.{d}.mlp.shared_expert.{s}", .{ layer, part });
+        n += 1;
+    }
+    return out[0..n];
+}
+
+/// `*` matches any run of characters (dots included), every other byte itself: the glob ModelOpt's ignore lists use.
+pub fn glob(pattern: []const u8, name: []const u8) bool {
+    var p: usize = 0;
+    var s: usize = 0;
+    var star: ?usize = null;
+    var mark: usize = 0;
+    while (s < name.len) {
+        if (p < pattern.len and pattern[p] == '*') {
+            star = p;
+            p += 1;
+            mark = s;
+        } else if (p < pattern.len and pattern[p] == name[s]) {
+            p += 1;
+            s += 1;
+        } else if (star) |at| {
+            p = at + 1;
+            mark += 1;
+            s = mark;
+        } else return false;
+    }
+    while (p < pattern.len and pattern[p] == '*') p += 1;
+    return p == pattern.len;
+}
+
+fn ignored(ignore: []const std.json.Value, name: []const u8) bool {
+    for (ignore) |v| if (v == .string and glob(v.string, name)) return true;
+    return false;
+}
+
+fn int(o: std.json.ObjectMap, name: []const u8) ?i64 {
+    const v = o.get(name) orelse return null;
+    return if (v == .integer) v.integer else null;
+}
+
+fn word(o: std.json.ObjectMap, name: []const u8, want: []const u8) bool {
+    const v = o.get(name) orelse return false;
+    return v == .string and std.mem.eql(u8, v.string, want);
+}
+
+/// FP4 E2M1 with 16-wide groups: the one NVFP4 weight form the routed experts load.
+fn nvfp4(o: std.json.ObjectMap) bool {
+    return int(o, "num_bits") == 4 and word(o, "type", "float") and int(o, "group_size") == 16;
+}
+
+/// The first field where `quant` (quant_algo NVFP4) differs from NVIDIA's per-layer layout, or null when it matches.
+pub fn mismatch(quant: std.json.ObjectMap) ?[]const u8 {
+    if (int(quant, "group_size")) |g| if (g != 16) return "quantization_config.group_size";
+    const groups_v = quant.get("config_groups") orelse return "quantization_config.config_groups";
+    if (groups_v != .object or groups_v.object.count() != 1) return "quantization_config.config_groups";
+    const group = groups_v.object.values()[0];
+    if (group != .object) return "quantization_config.config_groups";
+    const weights = group.object.get("weights") orelse return "quantization_config.config_groups";
+    if (weights != .object or !nvfp4(weights.object)) return "quantization_config.config_groups";
+    const ignore_v = quant.get("ignore") orelse return "quantization_config.ignore";
+    if (ignore_v != .array) return "quantization_config.ignore";
+    const ignore = ignore_v.array.items;
+    var buf: [8][128]u8 = undefined;
+    var out: [8][]const u8 = undefined;
+    var name: [128]u8 = undefined;
+    for (0..wt.layers_n) |layer| {
+        // routed experts quantized: no ignore pattern names their projections
+        for ([_][]const u8{ "gate_proj", "up_proj", "down_proj" }) |part| {
+            const routed = std.fmt.bufPrint(&name, "model.language_model.layers.{d}.mlp.experts.0.{s}", .{ layer, part }) catch unreachable;
+            if (ignored(ignore, routed)) return "quantization_config.routed_experts";
+        }
+        for (bf16Modules(layer, &buf, &out) catch unreachable) |m| {
+            if (!ignored(ignore, m)) return if (std.mem.indexOf(u8, m, "shared_expert") != null) "quantization_config.shared_expert" else "quantization_config.attention_projection";
+        }
+    }
+    // the head keeps its checkpoint precision; cuda_fused_experts_load.zig reads its routed experts
+    if (!ignored(ignore, "mtp.layers.0.mlp.experts.gate_up_proj")) return "quantization_config.mtp";
+    return null;
+}
+
+fn sample(a: std.mem.Allocator) !std.json.ObjectMap {
+    var weights: std.json.ObjectMap = .empty;
+    try weights.put(a, "num_bits", .{ .integer = 4 });
+    try weights.put(a, "type", .{ .string = "float" });
+    try weights.put(a, "group_size", .{ .integer = 16 });
+    var group: std.json.ObjectMap = .empty;
+    try group.put(a, "weights", .{ .object = weights });
+    var groups: std.json.ObjectMap = .empty;
+    try groups.put(a, "group_0", .{ .object = group });
+    var ignore: std.json.Array = .init(a);
+    for ([_][]const u8{ "model.embed_tokens", "mtp.*", "*.self_attn.*", "*.linear_attn.*", "*.mlp.gate*", "*.mlp.shared_expert.*", "*.ple.*", "lm_head" }) |p| try ignore.append(.{ .string = p });
+    var quant: std.json.ObjectMap = .empty;
+    try quant.put(a, "quant_method", .{ .string = "modelopt" });
+    try quant.put(a, "quant_algo", .{ .string = "NVFP4" });
+    try quant.put(a, "config_groups", .{ .object = groups });
+    try quant.put(a, "ignore", .{ .array = ignore });
+    return quant;
+}
+
+test "ModelOpt's ignore globs match across dots and anchor both ends" {
+    try std.testing.expect(glob("*.self_attn.*", "model.language_model.layers.3.self_attn.q_proj"));
+    try std.testing.expect(glob("mtp.*", "mtp.layers.0.mlp.experts.gate_up_proj"));
+    try std.testing.expect(glob("*.mlp.gate*", "model.language_model.layers.0.mlp.gate"));
+    try std.testing.expect(!glob("*.mlp.gate*", "model.language_model.layers.0.mlp.experts.0.gate_proj"));
+    try std.testing.expect(!glob("lm_head", "lm_head.weight"));
+    try std.testing.expect(glob("**", ""));
+}
+
+test "a uniform NVFP4 config with every non-routed module ignored reads as NVIDIA's layout; each gap is named" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var quant = try sample(a);
+    try std.testing.expect(mismatch(quant) == null);
+    const ignore = quant.getPtr("ignore").?;
+    const cases = [_]struct { drop: []const u8, refused: []const u8 }{
+        .{ .drop = "*.self_attn.*", .refused = "quantization_config.attention_projection" },
+        .{ .drop = "*.mlp.shared_expert.*", .refused = "quantization_config.shared_expert" },
+        .{ .drop = "mtp.*", .refused = "quantization_config.mtp" },
+    };
+    for (cases) |c| {
+        const saved = try ignore.array.clone();
+        var kept: std.json.Array = .init(a);
+        for (saved.items) |v| if (!std.mem.eql(u8, v.string, c.drop)) try kept.append(v);
+        ignore.* = .{ .array = kept };
+        try std.testing.expectEqualStrings(c.refused, mismatch(quant) orelse "accepted");
+        ignore.* = .{ .array = saved };
+    }
+    try ignore.array.append(.{ .string = "*.mlp.experts.*" });
+    try std.testing.expectEqualStrings("quantization_config.routed_experts", mismatch(quant).?);
+    _ = ignore.array.pop();
+    const w = quant.getPtr("config_groups").?.object.getPtr("group_0").?.object.getPtr("weights").?;
+    try w.object.put(a, "group_size", .{ .integer = 32 });
+    try std.testing.expectEqualStrings("quantization_config.config_groups", mismatch(quant).?);
+}
