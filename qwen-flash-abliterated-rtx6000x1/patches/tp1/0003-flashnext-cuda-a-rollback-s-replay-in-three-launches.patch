+/// TF_FLASHNEXT_ROLL_BATCH=1: a replay's ~146 launches as 3 (every layer's front, every chain, every window shift).
+pub fn batch() bool {
+    // the startup check refused every malformed value already, so a plain default stands here
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_ROLL_BATCH", false) catch false;
+}
+
+/// fn_replay::Layer and Layers, by value: a DeltaNet layer's kept rows, window, weights and state.
+const ReplayLayer = extern struct { proj: u64 = 0, hist: u64 = 0, cw: u64 = 0, a_log: u64 = 0, dt: u64 = 0, state: u64 = 0 };
+const ReplayLayers = extern struct { l: [parts.roll_jobs_max]ReplayLayer = @splat(.{}), n: c_int = 0 };
+
+comptime {
+    std.debug.assert(@sizeOf(ReplayLayer) == 48 and @sizeOf(ReplayLayers) == 1928);
+}
+
+/// One layer's slice of the batched replay's space at `rows` rows: q, k, v, gates, outputs (fp32, whole heads).
+const replay_row_bytes = (2 * gdn.nk * gdn.dk + 2 * gdn.value_dim + gdn.nv * 2) * 4;
+
+/// Replay's programs over every DeltaNet layer, a launch a step (fronts read the saved windows); false: run the loop.
+fn batchedRun(r: Replay) !bool {
+    const k = &r.e.batch_k;
+    var t: ReplayLayers = .{};
+    var w: parts.RollJobs = .{};
+    var n: usize = 0;
+    var heads: ?@import("cuda_heads.zig").Heads = null;
+    var li: usize = 0;
+    for (r.e.layers[0..r.e.n_layers], 0..) |*lw, layer| {
+        if (!lw.linear) continue;
+        defer li += 1;
+        if (heads) |h| if (!h.eql(lw.heads)) return false;
+        heads = lw.heads;
+        if (n + 1 >= parts.roll_jobs_max) return false;
+        const lk = r.d.keep.layers[layer];
+        t.l[n] = .{ .proj = lk.proj, .hist = lk.hist, .cw = lw.cw.ptr, .a_log = lw.a_log.ptr, .dt = lw.dt.ptr, .state = r.seq.state[li].ptr };
+        w.j[n] = .{ .win = r.seq.conv[li].ptr, .hist = lk.hist, .rows = lk.proj, .stride = @intCast(lw.heads.projWidth()), .taps = @intCast(gdn.taps - 1), .c = @intCast(lw.heads.convDim()) };
+        n += 1;
+    }
+    const h = heads orelse return false;
+    w.j[n] = .{ .win = r.seq.tail.ptr, .hist = r.d.saved.ptr + r.d.layout.tail_at, .rows = r.d.saved.ptr + r.d.layout.nrow_at, .stride = @intCast(wt.wide), .taps = @intCast(wt.ple_tail_n), .c = @intCast(wt.wide) };
+    t.n = @intCast(n);
+    w.n = @intCast(n + 1);
+    const need = (parts.roll_jobs_max - 1) * @import("cuda_mtp.zig").max_rows * replay_row_bytes;
+    if (r.keep > @import("cuda_mtp.zig").max_rows) return false;
+    if (k.replay_space == null) k.replay_space = try cuda.DeviceBuffer.alloc(r.e.driver, need);
+    const rows = n * r.keep;
+    const q = k.replay_space.?.ptr;
+    const kk = q + rows * gdn.nk * gdn.dk * 4;
+    const v = kk + rows * gdn.nk * gdn.dk * 4;
+    const gb = v + rows * gdn.value_dim * 4;
+    const ys = gb + rows * gdn.nv * 2 * 4;
+    const g = try k.gdnSet(h);
+    var f: cuda.Args = .{};
+    f.add(t);
+    f.add(cint(r.keep));
+    for ([_]u64{ q, kk, v, gb }) |p| f.add(p);
+    try cuda.launch.launch(g.replay_front, .{ .grid = .{ .x = @intCast(r.keep), .y = h.nk + h.nv, .z = @intCast(n) }, .block = .{ .x = 256 } }, r.st, &f);
+    var c: cuda.Args = .{};
+    c.add(t);
+    c.add(cint(r.keep));
+    for ([_]u64{ q, kk, v, gb, ys }) |p| c.add(p);
+    try cuda.launch.launch(g.replay_chain, .{ .grid = .{ .x = h.nv, .y = gdn.dv / 16, .z = @intCast(n) }, .block = .{ .x = 128 } }, r.st, &c);
+    var a: cuda.Args = .{};
+    a.add(w);
+    a.add(cint(r.keep));
+    const widest = @max(h.convDim(), wt.wide);
+    try cuda.launch.launch(k.late_roll, .{ .grid = .{ .x = @intCast((widest + 255) / 256), .y = @intCast(n + 1) }, .block = .{ .x = 256 } }, r.st, &a);
+    return true;
+}
+
 /// The replay of `keep` kept rows; its ~146 launches as one graph on each rank, keyed by every buffer they touch.
 pub fn replay(e: *prompt.Engine, s: *parts.Scratch, seq: *prompt.Seq, d: *Draft, keep: usize) !void {
     return graphed(e, s, seq, d, keep, Replay{ .e = e, .st = e.stream.*, .s = s, .seq = seq, .d = d, .keep = keep });
