@@ -0,0 +1,59 @@
+// A rollback's replay over every DeltaNet layer, one launch a step (blockIdx.z the layer, its lone launch's program).
+namespace fn_replay {
+constexpr int MAXL = 40;
+struct Layer {
+    const __nv_bfloat16* proj;  // the kept rows' projections
+    const __nv_bfloat16* hist;  // the conv window before them (the window's start)
+    const __nv_bfloat16* cw;
+    const float* a_log;
+    const float* dt_bias;
+    float* state;  // the layer's DeltaNet state, replayed in place
+};
+struct Layers {
+    Layer l[MAXL];
+    int n;
+};
+}  // namespace fn_replay
+
+// fn_gdn_front of each layer on grid (keep, NK + NV, layers): layer z's q, k, v and gates at its own keep rows.
+template <int NK, int NV>
+static __device__ __forceinline__ void replay_front(const fn_replay::Layers& t, int keep, float* qn, float* kn, float* v, float* gb) {
+    using namespace fn_gdn;
+    const fn_replay::Layer& l = t.l[blockIdx.z];
+    const size_t z = blockIdx.z, rows = (size_t)keep;
+    gdn_front<NK, NV, false>(l.proj, l.hist, l.cw, l.a_log, l.dt_bias, qn + z * rows * NK * DK, kn + z * rows * NK * DK,
+                             v + z * rows * NV * DV, gb + z * rows * NV * 2, nullptr, 1);
+}
+
+// fn_gdn_rows of each layer on grid (NV, DV / 16, layers): its state through its keep rows (ys discarded per layer).
+template <int NK, int NV>
+static __device__ __forceinline__ void replay_chain(const fn_replay::Layers& t, int keep, const float* qn, const float* kn,
+                                                    const float* v, const float* gb, float* ys) {
+    using namespace fn_gdn;
+    const fn_replay::Layer& l = t.l[blockIdx.z];
+    const size_t z = blockIdx.z, rows = (size_t)keep;
+    gdn_rows<NK, NV>(qn + z * rows * NK * DK, kn + z * rows * NK * DK, v + z * rows * NV * DV, gb + z * rows * NV * 2, l.state,
+                     l.state, keep, ys + z * rows * NV * DV);
+}
+
+extern "C" __global__ void __launch_bounds__(256) fn_replay_front(const fn_replay::Layers t, int keep, float* qn, float* kn,
+                                                                  float* v, float* gb) {
+    replay_front<16, 48>(t, keep, qn, kn, v, gb);
+}
+
+extern "C" __global__ void __launch_bounds__(256) fn_replay_front_h8(const fn_replay::Layers t, int keep, float* qn,
+                                                                     float* kn, float* v, float* gb) {
+    replay_front<8, 24>(t, keep, qn, kn, v, gb);
+}
+
+extern "C" __global__ void __launch_bounds__(128) fn_replay_chain(const fn_replay::Layers t, int keep, const float* qn,
+                                                                  const float* kn, const float* v, const float* gb,
+                                                                  float* ys) {
+    replay_chain<16, 48>(t, keep, qn, kn, v, gb, ys);
+}
+
+extern "C" __global__ void __launch_bounds__(128) fn_replay_chain_h8(const fn_replay::Layers t, int keep, const float* qn,
+                                                                     const float* kn, const float* v, const float* gb,
+                                                                     float* ys) {
+    replay_chain<8, 24>(t, keep, qn, kn, v, gb, ys);
+}
