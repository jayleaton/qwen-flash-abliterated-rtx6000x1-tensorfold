+/// moeBlockKeep's router and top-k: the fused launches where they take the pass (true: own picks and plan written too).
+pub fn route(self: anytype, lw: anytype, n: usize, plan: cuda.grouped.Plan) !bool {
+    if (lw.native_experts) |*native| if (try run(self, native, n, lw.router.ptr, plan)) return true;
+    const s = self.s;
+    try self.tri.routerMany(s.mixed, lw.router.ptr, s.router_l, wt.dims, n);
+    try self.tri.topkMany(s.router_l, s.picks, s.wts, n, s.slots);
+    return false;
+}
